# Copia a .env. Nunca subas .env.
DATABASE_URL=postgresql+psycopg://pixtart:pixtart@db:5432/pixtart
VALKEY_URL=redis://valkey:6379/0
# Almacén de PDFs: disco (volumen compartido) o s3
ALMACEN=disco
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=pixtart
S3_SECRET_KEY=pixtart-dev-secret
S3_BUCKET=pdfs
# Al menos 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Clave maestra para cifrar las API keys de los usuarios (Fernet, 32 bytes base64-url).
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=
